{
  "templateVersion": 1,
  "id": "rush-q",
  "name": "Rush Q",
  "description": "Corporate strategy card game — talent, projects, and skill plays across a fiscal year. Full-fidelity schema for the game's data/cards.json, including the minQuarter / status / source pipeline fields.",
  "typeField": "type",
  "sampleUrl": "data/cards.sample.json",
  "list": { "title": "name", "glyph": "emoji", "badge": "type" },
  "style": { "accentFrom": "type", "maxWidth": 320 },
  "types": [
    { "id": "Talent", "label": "Talent", "color": "#14b8a6" },
    { "id": "Project", "label": "Project", "color": "#ffc107" },
    { "id": "Project Queue", "label": "Project Queue", "color": "#f59e0b" },
    { "id": "Bonus Project", "label": "Bonus Project", "color": "#fbbf24" },
    { "id": "Soft", "label": "Soft", "color": "#c084fc" },
    { "id": "Hard", "label": "Hard", "color": "#0ea5e9" },
    { "id": "Power", "label": "Power", "color": "#9333ea" },
    { "id": "Team", "label": "Team", "color": "#3b82f6" },
    { "id": "Quarter Event", "label": "Quarter Event", "color": "#ef4444" },
    { "id": "Layoff", "label": "Layoff", "color": "#f9a8d4" },
    { "id": "Favor", "label": "Favor", "color": "#8a2be2" },
    { "id": "TL;DR", "label": "TL;DR", "color": "#a855f7" },
    { "id": "Trait", "label": "Trait", "color": "#f97316" },
    { "id": "CapEx", "label": "CapEx", "color": "#f59e0b" },
    { "id": "OpEx", "label": "OpEx", "color": "#c084fc" },
    { "id": "Individual", "label": "Individual", "color": "#2dd4bf" }
  ],
  "enums": {
    "deck": ["Budget", "Business", "Event", "Exercise", "For Hire", "Mission", "Player", "Rush Q!", "Skill", "Starter"],
    "effectType": ["Add Progress", "Assign", "Basic Negation", "Burst + Debt", "Choice", "Conditional Draw", "Deadline Reduction", "Draw 1 Bonus Project", "Draw 1 Skill", "Foresight", "Hiring", "People Loss", "Progress + Draw", "Progress Boost", "Project Freeze", "Protection", "Reputation Gain", "Reputation Loss", "Risk + Reward", "Shield", "Team Movement"],
    "subcategory": ["assessment", "assign", "budget", "burst", "choice", "crisis", "deadline", "draw", "hiring", "milestone", "opportunity", "passive", "progress", "project", "recovery", "recruit", "rep-gain", "rep-loss", "risk", "sabotage", "shield", "unknown"],
    "skillSubtype": ["Soft", "Hard", "Power", ""],
    "complexity": ["Simple", "Conditional", "Complex", "Passive", ""],
    "triggerTiming": ["Action", "Effect", "When Completed", "When Completed, Delayed", "Add-On", "Passive", "Delayed", ""],
    "yesno": ["No", "Yes"],
    "status": ["", "active", "draft"]
  },
  "fields": [
    { "key": "name", "label": "Name", "kind": "text", "group": "Identity", "required": true, "placeholder": "Card name" },
    { "key": "type", "label": "Type", "kind": "select", "group": "Identity", "fromTypes": true, "default": "Soft" },
    { "key": "deck", "label": "Deck", "kind": "select", "group": "Identity", "enum": "deck", "default": "Skill" },
    { "key": "quantity", "label": "Quantity", "kind": "number", "group": "Identity", "default": 1 },
    { "key": "skill", "label": "Skill / effect text", "kind": "textarea", "group": "Text", "placeholder": "What the card does in play" },
    { "key": "value", "label": "Value", "kind": "number", "group": "Stats" },
    { "key": "negationCost", "label": "Negation cost", "kind": "number", "group": "Skill mechanics", "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "emoji", "label": "Glyph", "kind": "icon", "group": "Visuals", "picks": ["sprout", "trending-up", "lightbulb", "zap", "flame", "shield", "coins", "target", "rocket", "users", "clipboard-list", "triangle-alert", "octagon-alert", "trophy"] },
    { "key": "flavorText", "label": "Flavor text", "kind": "textarea", "group": "Text", "placeholder": "Optional flavor line" },
    { "key": "colorCode", "label": "Color code", "kind": "text", "group": "Visuals", "picks": ["🟢", "🔴", "🟡", "🟤", "🔵", "🟣", "🟠", "⚪", "⚫"] },
    { "key": "icon", "label": "Icon (legacy)", "kind": "text", "group": "Visuals" },
    { "key": "deadline", "label": "Deadline (quarters)", "kind": "number", "group": "Project stats", "showIf": { "typeIn": ["Project", "Project Queue", "Bonus Project"] } },
    { "key": "members", "label": "Members", "kind": "number", "group": "Project stats", "showIf": { "typeIn": ["Project", "Project Queue", "Bonus Project"] } },
    { "key": "reward", "label": "Reward", "kind": "number", "group": "Project stats", "showIf": { "typeIn": ["Project", "Project Queue", "Bonus Project"] } },
    { "key": "penalty", "label": "Penalty", "kind": "number", "group": "Project stats", "showIf": { "typeIn": ["Project", "Project Queue", "Bonus Project"] } },
    { "key": "effectType", "label": "Effect type", "kind": "select", "group": "Skill mechanics", "enum": "effectType", "allowCustom": true, "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "complexity", "label": "Complexity", "kind": "select", "group": "Advanced", "enum": "complexity", "default": "Simple" },
    { "key": "skillSubtype", "label": "Skill subtype", "kind": "select", "group": "Skill mechanics", "enum": "skillSubtype", "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "triggerTiming", "label": "Trigger timing", "kind": "select", "group": "Skill mechanics", "enum": "triggerTiming", "default": "Action", "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "multipleEffects", "label": "Multiple effects", "kind": "select", "group": "Advanced", "enum": "yesno", "default": "No" },
    { "key": "playerCountScaling", "label": "Player-count scaling", "kind": "select", "group": "Advanced", "enum": "yesno", "default": "No" },
    { "key": "baseValue", "label": "Base value", "kind": "number", "group": "Stats" },
    { "key": "opportunitySkill", "label": "Opportunity skill", "kind": "textarea", "group": "Advanced", "placeholder": "Optional" },
    { "key": "recommendedNegationCost", "label": "Recommended negation", "kind": "number", "group": "Advanced" },
    { "key": "opExCost", "label": "OpEx cost", "kind": "number", "group": "Skill mechanics", "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "image", "label": "Image", "kind": "image", "group": "Visuals" },
    { "key": "chanceSkill", "label": "Chance skill", "kind": "textarea", "group": "Advanced", "placeholder": "Optional" },
    { "key": "subcategory", "label": "Subcategory", "kind": "select", "group": "Skill mechanics", "enum": "subcategory", "allowCustom": true, "default": "unknown", "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "key": "minQuarter", "label": "Min quarter (timing gate)", "kind": "number", "group": "Pipeline", "optional": true },
    { "key": "status", "label": "Status", "kind": "select", "group": "Pipeline", "enum": "status", "optional": true },
    { "key": "source", "label": "Source", "kind": "text", "group": "Pipeline", "optional": true, "placeholder": "expansion" }
  ],
  "layout": [
    { "block": "header", "title": "name", "tag": "type", "glyph": "emoji", "badge": "colorCode" },
    { "block": "art", "field": "image" },
    { "block": "text", "field": "skill" },
    { "block": "badges", "fields": ["effectType", "subcategory"], "showIf": { "typeIn": ["Soft", "Hard", "Power"] } },
    { "block": "flavor", "field": "flavorText" },
    { "block": "stats", "showIf": { "typeIn": ["Project", "Project Queue", "Bonus Project"] }, "pips": [
      { "field": "members", "icon": "users", "label": "Members" },
      { "field": "deadline", "icon": "hourglass", "label": "Deadline" },
      { "field": "reward", "icon": "star", "label": "Reward" },
      { "field": "penalty", "icon": "triangle-alert", "label": "Penalty" }
    ] },
    { "block": "stats", "showIf": { "typeIn": ["Soft", "Hard", "Power"] }, "pips": [
      { "field": "value", "icon": "hash", "label": "Value" },
      { "field": "opExCost", "icon": "coins", "label": "OpEx", "hideIfZero": true },
      { "field": "negationCost", "icon": "shield", "label": "Negation", "hideIfZero": true }
    ] },
    { "block": "footer", "fields": ["deck"] }
  ],
  "assets": { "svg": {} }
}
